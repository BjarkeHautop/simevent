Package: simevent
Title: Simulation and Analysis of Event History Data
Version: 0.1.1.9000
Authors@R: c(
    person(given = "Michaela", family = "Lukacova", email = "michaela.lukacova@sund.ku.dk", role = c("aut", "cre")),
